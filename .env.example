# Copy to .env and fill in. NEVER commit .env.
# Local dev only — in GitHub Actions these are Secrets, not a file.

# Sync token for pushing to your forks (fine-grained PAT).
GITFLOE_TOKEN=

# SMTP for the email handler + digest (Gmail: use an App Password).
GITFLOE_SMTP_HOST=smtp.gmail.com
GITFLOE_SMTP_PORT=587
GITFLOE_SMTP_USER=
GITFLOE_SMTP_PASS=
GITFLOE_MAIL_TO=

# LLM handler (only needed if a repo uses "handler: ai").
GITFLOE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
GITFLOE_AI_KEY=
GITFLOE_AI_MODEL=gpt-4o-mini
